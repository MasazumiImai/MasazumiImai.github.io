---
import { type CollectionEntry, getEntry } from 'astro:content';
import { type Lang, localizePath } from '../i18n';
import { youtubeId } from '../utils/youtube';

interface Props {
  entry: CollectionEntry<'research'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const slug = entry.id.split('/').pop();
const featured = entry.data.featuredPublication ? await getEntry(entry.data.featuredPublication) : undefined;
const videoId = youtubeId(featured?.data.links.video);
const image = videoId ? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg` : entry.data.image;
---

<a class="card" href={`${localizePath('/research/', lang)}#${slug}`}>
  <div class="card-media">
    {image && <img src={image} alt="" loading="lazy" decoding="async" />}
  </div>
  <div class="card-body">
    <h3>{entry.data.title}</h3>
    <p>{entry.data.summary}</p>
  </div>
</a>

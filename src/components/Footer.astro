---
import { profile } from '../config';
import { type Lang, formatDate, t } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const now = new Date();
---

<footer class="site-footer">
  <div class="container">
    <p>&copy; {now.getUTCFullYear()} {profile.name.en}</p>
    <p>{t(lang, 'footer.updated')}: {formatDate(now)}</p>
  </div>
</footer>

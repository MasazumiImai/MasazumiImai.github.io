---
import { profile } from '../config';
import { type Lang, type UIKey, localizePath, switchLangPath, t } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const nav: { key: UIKey; path: string }[] = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.research', path: '/research/' },
  { key: 'nav.publications', path: '/publications/' },
  { key: 'nav.cv', path: '/cv/' },
];
const current = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localizePath('/', lang)}>{profile.name.en}</a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => {
            const href = localizePath(item.path, lang);
            const isCurrent = item.path === '/' ? current === href : current.startsWith(href);
            return (
              <li>
                <a href={href} aria-current={isCurrent ? 'page' : undefined}>
                  {t(lang, item.key)}
                </a>
              </li>
            );
          })
        }
      </ul>
      <div class="header-controls">
        <div class="lang-switch" role="group" aria-label={lang === 'ja' ? '言語切り替え' : 'Language selection'}>
          <a href={switchLangPath(current, 'ja')} hreflang="ja" lang="ja" aria-current={lang === 'ja' ? 'page' : undefined}>JP</a>
          <span aria-hidden="true">|</span>
          <a href={switchLangPath(current, 'en')} hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
        </div>
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          data-light-label={t(lang, 'theme.light')}
          data-dark-label={t(lang, 'theme.dark')}
          hidden
        >
          <span aria-hidden="true">◑</span>
        </button>
      </div>
    </nav>
  </div>
</header>

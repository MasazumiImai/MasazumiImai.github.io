---
import { getCollection } from 'astro:content';
import { type Lang, formatDate, localize } from '../i18n';

interface Props {
  lang: Lang;
  limit?: number;
}

const { lang, limit } = Astro.props;
const items = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, limit);
---

<ul class="news">
  {
    items.map((item) => {
      const text = localize(item.data.text, lang);
      const linkText = item.data.linkText ? localize(item.data.linkText, lang) : text;
      const linkIndex = text.indexOf(linkText);
      return (
        <li>
          <time datetime={item.data.date.toISOString().slice(0, 10)}>{formatDate(item.data.date)}</time>
          <span>
            {item.data.link && linkIndex >= 0 ? (
              <>
                {text.slice(0, linkIndex)}
                <a href={item.data.link}>{linkText}</a>
                {text.slice(linkIndex + linkText.length)}
              </>
            ) : text}
          </span>
        </li>
      );
    })
  }
</ul>

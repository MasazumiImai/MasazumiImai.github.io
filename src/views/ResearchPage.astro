---
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entries = (await getCollection('research', ({ id }) => id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    slug: entry.id.split('/').pop(),
    Content: (await render(entry)).Content,
    pubs: (await getEntries(entry.data.publications))
      .filter((pub) => lang === 'ja' || pub.data.type !== 'domestic')
      .sort((a, b) => b.data.year - a.data.year),
  })),
);
---

<Base lang={lang} title={t(lang, 'nav.research')}>
  <h1 class="page-title">{t(lang, 'nav.research')}</h1>
  <p class="lead">{t(lang, 'research.intro')}</p>
  {
    projects.map(({ entry, slug, Content, pubs }) => (
      <article class="project" id={slug}>
        {entry.data.image && <img class="project-image" src={entry.data.image} alt="" loading="lazy" />}
        <h2>{entry.data.title}</h2>
        {/*<p class="lead">{entry.data.summary}</p>*/}
        <div class="prose">
          <Content />
        </div>
        {pubs.length > 0 && (
          <>
            <h3 class="eyebrow">{t(lang, 'research.related')}</h3>
            <ol class="pub-list">
              {pubs.map((pub) => (
                <PubItem pub={pub} lang={lang} embedVideo />
              ))}
            </ol>
          </>
        )}
      </article>
    ))
  }
</Base>
